{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "types": ["node"]
  },
  "include": ["support/**/*.ts", "tests/**/*.ts"]
}
